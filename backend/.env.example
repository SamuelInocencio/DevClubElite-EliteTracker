# Modelo do .env. Este arquivo VAI para o git (só nomes, nunca valores reais).
# Copie para .env e preencha: cp .env.example .env

PORT=4000

# String de conexao do MongoDB. O banco (elitetracker) e criado sozinho
# na primeira escrita. Container: docker start elitetracker-mongo
MONGO_URL=mongodb://localhost:27017/elitetracker
