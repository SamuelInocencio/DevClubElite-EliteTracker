# Modelo do .env do front. Este arquivo VAI para o git; o .env não.
# Copie para .env: cp .env.example .env
#
# ATENÇÃO: no Vite, só variáveis com o prefixo VITE_ chegam no código do
# navegador. Uma variável sem esse prefixo é simplesmente ignorada.
# E tudo que tem VITE_ fica VISÍVEL para qualquer um que abrir o site —
# nunca coloque segredo aqui (senha, chave de API, JWT secret).

VITE_API_URL=http://localhost:4000
